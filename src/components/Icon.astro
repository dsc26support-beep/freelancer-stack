---
// Simple line icons, drawn for this site.
interface Props { name: 'invoice' | 'contract' | 'clock' | 'calendar' | 'arrow' | 'layers'; }
const { name } = Astro.props;
---
<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {name === 'invoice' && <><path d="M6 3h12v18l-3-2-3 2-3-2-3 2z" /><path d="M9 8h6M9 12h6M9 16h3" /></>}
  {name === 'contract' && <><path d="M14 3H6v18h12V7z" /><path d="M14 3v4h4" /><path d="M9 17c1-1.5 2-1.5 3 0s2 1.5 3 0" /></>}
  {name === 'clock' && <><circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 2" /></>}
  {name === 'calendar' && <><rect x="3" y="5" width="18" height="16" rx="2" /><path d="M3 10h18M8 3v4M16 3v4" /></>}
  {name === 'arrow' && <path d="M7 17 17 7M9 7h8v8" />}
  {name === 'layers' && <><path d="m12 3 9 5-9 5-9-5z" /><path d="m3 13 9 5 9-5" /></>}
</svg>
