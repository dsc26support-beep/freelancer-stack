---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
---
<Base title="About | Freelancer Stack">
  <PageHero label="About" title="Software advice without the sales pitch." />
  <section class="page-body">
    <div class="wrap prose">
      <p>Freelancer Stack compares business software for freelancers: invoicing, contracts, time tracking and scheduling.</p>
      <p>We aim to be plain about trade-offs. If we have not tested something ourselves, we say so.</p>
      <p class="placeholder">To do: add your name, background and why you write about this. First-hand credibility matters here.</p>
    </div>
  </section>
</Base>
