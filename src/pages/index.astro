---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';

const published = (await getCollection('articles', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const fmt = (d: Date) => d.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });

const layers = [
  { name: 'Win the client', line: 'Proposals, e-signatures and client tracking.' },
  { name: 'Book the work', line: 'Scheduling without the email ping-pong.' },
  { name: 'Track the hours', line: 'See where your week actually goes.' },
  { name: 'Get paid', line: 'Invoicing that chases payments for you.' },
];
---
<Base title="Freelance Stack: honest software picks for freelancers">
  <section class="hero" aria-labelledby="hero-title">
    <div class="container hero-grid">
      <div>
        <h1 id="hero-title">Build a freelance stack that pays.</h1>
        <p class="lead">Invoicing, contract, time and scheduling tools: who each suits, what it costs.</p>
        <div class="hero-actions">
          <a class="btn" href="#topics">Explore the stack</a>
          <a class="btn btn--quiet" href="#how">How we choose</a>
        </div>
      </div>

      <article class="verdict" aria-labelledby="verdict-title">
        <p class="verdict-from">From <a href="/articles/freshbooks-vs-honeybook/">FreshBooks vs HoneyBook</a></p>
        <h2 id="verdict-title">Bookkeeper or booking system?</h2>
        <div class="verdict-picks">
          <div class="verdict-pick">
            <h3>HoneyBook</h3>
            <p>Proposals, contracts, deposits.</p>
            <p class="verdict-cost">$348 <small>a year</small></p>
            <p class="verdict-plan">Starter, billed yearly</p>
          </div>
          <div class="verdict-pick">
            <h3>FreshBooks</h3>
            <p>Hourly work, retainers, bookkeeping.</p>
            <p class="verdict-cost">$276 <small>a year</small></p>
            <p class="verdict-plan">Lite, up to 5 clients</p>
          </div>
        </div>
        <p class="verdict-catch"><strong>The catch:</strong> client six moves FreshBooks to $516 a year.</p>
      </article>
    </div>
  </section>

  <section class="section" aria-labelledby="guides-title">
    <div class="container">
      <div class="head head--split">
        <h2 id="guides-title">Every guide, newest first</h2>
        <p class="lead">Each compares tools side by side, with prices checked on the vendor’s own page.</p>
      </div>
      {published.length === 0
        ? <p class="lead">The first guides are being written. We publish only once the facts are checked.</p>
        : <ol class="index">
            {published.map((a) => (
              <li>
                <a href={`/articles/${a.id}/`}>
                  <h3>{a.data.title}</h3>
                  {a.data.compares && <span class="compares">{a.data.compares.join(', ')}</span>}
                  <time datetime={(a.data.updatedDate ?? a.data.pubDate).toISOString().slice(0, 10)}>{fmt(a.data.updatedDate ?? a.data.pubDate)}</time>
                </a>
              </li>
            ))}
          </ol>}
      {published.length > 0 && <p class="index-foot"><a class="btn btn--quiet" href="/articles/">See all guides</a></p>}
    </div>
  </section>

  <section class="section" id="topics" aria-labelledby="layers-title">
    <div class="container layers-wrap">
      <div class="head">
        <h2 id="layers-title">Four layers. One working business.</h2>
        <p class="lead">Most freelancers need the same four jobs done.</p>
      </div>
      <ol class="layers">
        {layers.map((l) => (
          <li>
            <h3>{l.name}</h3>
            <p>{l.line}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section" id="how" aria-labelledby="how-title">
    <div class="container">
      <h2 id="how-title" class="how-title">How we choose.</h2>
      <p class="statement">Every guide names who should skip the tool, checks prices on the vendor’s own page, and labels every paid link.</p>
      <dl class="stats">
        <div><dt>tool categories covered</dt><dd>4</dd></div>
        <div><dt>paid placements</dt><dd>0</dd></div>
        <div><dt>of affiliate links disclosed</dt><dd>100%</dd></div>
      </dl>
    </div>
  </section>

  <section class="band" aria-labelledby="close-title">
    <div class="container">
      <h2 id="close-title">Stuck choosing a tool?</h2>
      <div class="band-body">
        <p class="lead">Tell us what you’re trying to pick. The most-asked comparisons become our next guides.</p>
        <a class="btn btn--quiet" href="/contact/">Suggest a comparison</a>
      </div>
    </div>
  </section>
</Base>
