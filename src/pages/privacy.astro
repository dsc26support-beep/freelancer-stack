---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
---
<Base title="Privacy | Freelancer Stack">
  <PageHero label="Privacy" title="Privacy policy" />
  <section class="page-body">
    <div class="wrap prose">
      <p>This site does not currently use analytics cookies or collect personal data.</p>
      <p>If we add an email signup, we will only email people who opt in, and every email will include an unsubscribe link.</p>
      <p>Affiliate links go to third-party sites, which have their own privacy policies and may set cookies to credit referrals.</p>
      <p class="placeholder">To do: review this page with a professional before collecting email addresses or adding analytics.</p>
    </div>
  </section>
</Base>
