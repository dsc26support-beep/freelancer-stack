---
import Base from '../layouts/Base.astro';
---
<Base title="Affiliate disclosure | Freelancer Stack">
  <div class="narrow prose">
    <h1>Affiliate disclosure</h1>
    <p>Freelancer Stack earns money through affiliate links. When you click a link and buy or sign up, the company may pay us a commission. You pay the same price either way.</p>
    <p>Affiliate links are marked and carry <code>rel="sponsored"</code>. Commissions do not decide what we write: each article says who a tool suits and who should skip it, including tools we earn nothing from.</p>
    <p>Prices and features change. Check the vendor's own page before you buy.</p>
  </div>
</Base>
