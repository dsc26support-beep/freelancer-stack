---
import '@fontsource-variable/inter';
import '@fontsource-variable/space-grotesk';
import '../styles/global.css';
import Icon from '../components/Icon.astro';

interface Props {
  title: string;
  description?: string;
}
const { title, description = 'Honest software comparisons for freelancers.' } = Astro.props;
const path = Astro.url.pathname;
const links = [
  { href: '/', label: 'Home' },
  { href: '/articles/', label: 'Guides' },
  { href: '/about/', label: 'About' },
  { href: '/disclosure/', label: 'How we earn' },
];
const isCurrent = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#0a0d0c" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="canonical" href={new URL(path, Astro.site)} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <header class="site-header" id="top">
      <div class="wrap">
        <a class="brand" href="/" aria-label="Freelancer Stack home">
          <span class="brand-mark"><Icon name="layers" /></span>
          Freelancer Stack
        </a>
        <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-nav" aria-label="Open menu"><span></span></button>
        <nav class="site-nav" id="site-nav" aria-label="Main">
          {links.map((l) => <a href={l.href} aria-current={isCurrent(l.href) ? 'page' : undefined}>{l.label}</a>)}
          <a class="btn" href="/contact/">Contact</a>
        </nav>
      </div>
    </header>

    <main><slot /></main>

    <footer class="site-footer dark">
      <div class="wrap">
        <div class="foot-grid">
          <div>
            <a class="brand" href="/"><span class="brand-mark"><Icon name="layers" /></span>Freelancer Stack</a>
            <p class="muted" style="margin-top:1rem;max-width:26rem">Plain-spoken software picks for people who work for themselves. We say who each tool suits, and who should skip it.</p>
          </div>
          <div>
            <h4>Explore</h4>
            <nav aria-label="Footer explore">
              <a href="/articles/">Guides</a>
              <a href="/about/">About</a>
              <a href="/contact/">Contact</a>
            </nav>
          </div>
          <div>
            <h4>Trust</h4>
            <nav aria-label="Footer trust">
              <a href="/disclosure/">Affiliate disclosure</a>
              <a href="/privacy/">Privacy</a>
            </nav>
          </div>
        </div>
        <div class="wordmark" aria-hidden="true">Freelancer<br />Stack</div>
        <div class="foot-bottom">
          <span>Some links are affiliate links. We may earn a commission at no extra cost to you.</span>
          <a href="#top" style="text-decoration:none">Back to top ↑</a>
        </div>
      </div>
    </footer>

    <script>
      const header = document.querySelector('.site-header');
      const toggle = document.querySelector('.nav-toggle');
      toggle?.addEventListener('click', () => {
        const open = header?.classList.toggle('nav-open') ?? false;
        toggle.setAttribute('aria-expanded', String(open));
        toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
      });
      document.querySelectorAll('.site-nav a').forEach((a) =>
        a.addEventListener('click', () => {
          header?.classList.remove('nav-open');
          toggle?.setAttribute('aria-expanded', 'false');
        })
      );
    </script>
  </body>
</html>
